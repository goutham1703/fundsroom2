generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

enum InventoryAction {
  RESERVE
  RELEASE
  DISPATCH
}

model User {
  id             Int               @id @default(autoincrement())
  email          String            @unique
  passwordHash   String            @map("password_hash")
  name           String
  role           UserRole          @default(SALES_USER)
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  customers      Customer[]
  enquiries      Enquiry[]
  quotations     Quotation[]
  orders         SalesOrder[]      @relation("OrderCreator")
  confirmedOrders SalesOrder[]     @relation("OrderConfirmer")
  dispatches     Dispatch[]
  inventory      Inventory[]
  auditLogs      InventoryAuditLog[]
  @@map("users")
}

model Customer {
  id           Int        @id @default(autoincrement())
  companyName  String     @unique @map("company_name")
  contactPerson String?   @map("contact_person")
  mobile       String?
  email        String?
  city         String?
  createdById  Int        @map("created_by")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    User       @relation(fields: [createdById], references: [id])
  enquiries    Enquiry[]
  quotations   Quotation[]
  orders       SalesOrder[]
  @@map("customers")
}

model Product {
  id          Int       @id @default(autoincrement())
  productCode String    @unique @map("product_code")
  productName String    @map("product_name")
  category    String?
  unit        String
  basePrice   Decimal   @db.Decimal(12, 2) @map("base_price")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  inventory   Inventory?
  enquiryItems EnquiryItem[]
  quotationItems QuotationItem[]
  orderItems  SalesOrderItem[]
  dispatchItems DispatchItem[]
  auditLogs   InventoryAuditLog[]
  @@map("products")
}

model Inventory {
  id               Int      @id @default(autoincrement())
  productId        Int      @unique @map("product_id")
  physicalQuantity Decimal  @default(0) @db.Decimal(12, 2) @map("physical_quantity")
  reservedQuantity Decimal  @default(0) @db.Decimal(12, 2) @map("reserved_quantity")
  lastUpdated      DateTime @updatedAt @map("last_updated")
  updatedById      Int      @map("updated_by")
  product          Product  @relation(fields: [productId], references: [id])
  updatedBy        User     @relation(fields: [updatedById], references: [id])
  @@map("inventory")
}

model Enquiry {
  id              Int           @id @default(autoincrement())
  enquiryNumber   String        @unique @map("enquiry_number")
  customerId      Int           @map("customer_id")
  enquiryDate     DateTime      @default(now()) @map("enquiry_date")
  requiredDate    DateTime?     @map("required_date")
  status          EnquiryStatus  @default(NEW)
  createdById     Int           @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  customer        Customer      @relation(fields: [customerId], references: [id])
  createdBy       User          @relation(fields: [createdById], references: [id])
  items           EnquiryItem[]
  quotation       Quotation?
  @@map("enquiries")
}

model EnquiryItem {
  id        Int      @id @default(autoincrement())
  enquiryId Int      @map("enquiry_id")
  productId Int      @map("product_id")
  quantity  Decimal  @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
  @@map("enquiry_items")
}

model Quotation {
  id              Int             @id @default(autoincrement())
  quotationNumber String          @unique @map("quotation_number")
  enquiryId       Int             @unique @map("enquiry_id")
  customerId      Int             @map("customer_id")
  quotationDate   DateTime        @default(now()) @map("quotation_date")
  validUntil      DateTime?       @map("valid_until")
  status          QuotationStatus @default(DRAFT)
  totalAmount     Decimal         @default(0) @db.Decimal(12, 2) @map("total_amount")
  gstAmount       Decimal         @default(0) @db.Decimal(12, 2) @map("gst_amount")
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2) @map("discount_amount")
  createdById     Int             @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  enquiry         Enquiry         @relation(fields: [enquiryId], references: [id])
  customer        Customer        @relation(fields: [customerId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])
  items           QuotationItem[]
  order           SalesOrder?
  @@map("quotations")
}

model QuotationItem {
  id              Int      @id @default(autoincrement())
  quotationId     Int      @map("quotation_id")
  productId       Int      @map("product_id")
  quantity        Decimal  @db.Decimal(12, 2)
  unitPrice       Decimal  @db.Decimal(12, 2) @map("unit_price")
  discountPercent Decimal  @default(0) @db.Decimal(5, 2) @map("discount_percent")
  gstPercent      Decimal  @default(18) @db.Decimal(5, 2) @map("gst_percent")
  lineAmount      Decimal  @db.Decimal(12, 2) @map("line_amount")
  createdAt       DateTime @default(now()) @map("created_at")
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])
  @@map("quotation_items")
}

model SalesOrder {
  id            Int        @id @default(autoincrement())
  orderNumber   String     @unique @map("order_number")
  quotationId   Int        @unique @map("quotation_id")
  customerId    Int        @map("customer_id")
  orderDate     DateTime   @default(now()) @map("order_date")
  totalAmount   Decimal    @db.Decimal(12, 2) @map("total_amount")
  status        OrderStatus @default(PENDING)
  confirmedById Int?       @map("confirmed_by")
  confirmedAt   DateTime?  @map("confirmed_at")
  createdById   Int        @map("created_by")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  quotation     Quotation  @relation(fields: [quotationId], references: [id])
  customer      Customer   @relation(fields: [customerId], references: [id])
  confirmedBy   User?      @relation("OrderConfirmer", fields: [confirmedById], references: [id])
  createdBy     User       @relation("OrderCreator", fields: [createdById], references: [id])
  items         SalesOrderItem[]
  dispatch      Dispatch?
  @@map("sales_orders")
}

model SalesOrderItem {
  id           Int       @id @default(autoincrement())
  salesOrderId Int       @map("sales_order_id")
  productId    Int       @map("product_id")
  quantity     Decimal   @db.Decimal(12, 2)
  unitPrice    Decimal   @db.Decimal(12, 2) @map("unit_price")
  createdAt    DateTime  @default(now()) @map("created_at")
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id])
  @@map("sales_order_items")
}

model Dispatch {
  id             Int          @id @default(autoincrement())
  dispatchNumber String       @unique @map("dispatch_number")
  salesOrderId   Int          @unique @map("sales_order_id")
  dispatchDate   DateTime     @default(now()) @map("dispatch_date")
  vehicleNumber  String?      @map("vehicle_number")
  driverName     String?      @map("driver_name")
  createdById    Int          @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  salesOrder     SalesOrder   @relation(fields: [salesOrderId], references: [id])
  createdBy      User         @relation(fields: [createdById], references: [id])
  items          DispatchItem[]
  @@map("dispatches")
}

model DispatchItem {
  id                Int      @id @default(autoincrement())
  dispatchId        Int      @map("dispatch_id")
  productId         Int      @map("product_id")
  quantityDispatched Decimal  @db.Decimal(12, 2) @map("quantity_dispatched")
  createdAt         DateTime @default(now()) @map("created_at")
  dispatch          Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id])
  @@map("dispatch_items")
}

model InventoryAuditLog {
  id             Int            @id @default(autoincrement())
  productId      Int            @map("product_id")
  action         InventoryAction
  quantityChanged Decimal        @db.Decimal(12, 2) @map("quantity_changed")
  referenceId    String?        @map("reference_id")
  createdById    Int            @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  product        Product        @relation(fields: [productId], references: [id])
  createdBy      User           @relation(fields: [createdById], references: [id])
  @@map("inventory_audit_log")
}